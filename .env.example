# Copy to .env; docker compose reads it automatically.
#
# Local defaults below run the stack at http://localhost:8080 (site) and
# http://localhost:8081 (text mirror), no TLS. In production, set the
# real hosts, without a scheme, the standard ports, and AUTO_HTTPS to
# ignore_loaded_certs so Caddy fetches the certificates itself (Caddy
# accepts no `on`: any value but off or disable_certs keeps automatic
# HTTPS, and this one changes nothing else):
#
#   SITE_HOST=tilder.thosted.fr
#   TEXT_HOST=text.example.org   # required: left blank, it falls back
#                                # to text.site.localhost
#   SITE_PORT=80
#   HTTPS_PORT=443
#   TEXT_PORT=127.0.0.1:8081     # the :81 catch-all serves the text
#                                # mirror to any Host, over plain HTTP;
#                                # TEXT_HOST already serves it on 443,
#                                # so keep 8081 off the public interface
#   AUTO_HTTPS=ignore_loaded_certs

SITE_HOST=http://site.localhost
TEXT_HOST=http://text.site.localhost
SITE_PORT=8080
TEXT_PORT=8081
HTTPS_PORT=8443
AUTO_HTTPS=off
